# kamusm.env — config for the KamuSM signing wrapper
#
# Illustrative layout for a clustered indexer peer (adjust paths to your site).
# Deploy the same pattern on every peer that holds local buckets; keep KAMUSMDB
# local to the host (at RF=N you get up to N stamps per logical bucket).
#
# Install:
#     sudo install -o splunk -g splunk -m 0600 kamusm.env.example /opt/kamusm/script/kamusm.env
# Then edit the password and the INDEXES list below.

# --- Batch signer + Zamane jar ----------------------------------------------
SIGNER=/opt/kamusm/script/kamusm_timestamp.sh
KAMUSM_JAR_PATH=/opt/kamusm/script/tss-client-console-3.1.33.jar

# --- Splunk DB root + local token store -------------------------------------
# Buckets: $SPLUNKDB/<index>/{db,colddb,thaweddb}/<bucket>/rawdata/l2Hash_*.dat
SPLUNKDB=/opt/splunk/var/lib/splunk
# LOCAL store on this indexer (do not share this path between peers).
KAMUSMDB=/opt/kamusm/db

# --- Which indexes to sign --------------------------------------------------
# Space-separated subset, or the literal word ALL. >>> EDIT THIS <<<
INDEXES="firewall dns waf"

# --- KamuSM / Zamane credentials & endpoint ---------------------------------
KAMUSM_CUSTOMER_NO=1234
KAMUSM_CUSTOMER_PASSWORD='CHANGE_ME'

# Production TSA (the tool defaults to the TEST server tzd.kamusm.gov.tr).
KAMUSM_TSA_URL=http://zd.kamusm.gov.tr
KAMUSM_TSA_PORT=80
KAMUSM_HASH_ALG=sha-256

# jar = live TSA (default). Use mock only for offline dry testing.
KAMUSM_BACKEND=jar

# --- Scheduler environment --------------------------------------------------
# cron has a bare PATH; make sure `java` is findable. Check with:  which java
# If java lives elsewhere, add its dir here (e.g. /usr/lib/jvm/.../bin).
EXTRA_PATH=/usr/bin:/usr/local/bin

# --- Proxy (optional; Zamane jar CLI args) ----------------------------------
# apt's /etc/apt/apt.conf does NOT apply. Map
#   Acquire::http::Proxy "http://user:pass@ip:port/"
# to (passed as positional args to java -jar ... -ZC; digest stays last):
# KAMUSM_PROXY_IP=PROXY_IP
# KAMUSM_PROXY_PORT=PROXY_PORT
# KAMUSM_PROXY_USER=USER
# KAMUSM_PROXY_PASSWORD='PASS'
# Auth user/password are optional; IP+PORT alone work for open proxies.
# verify (-CC) is offline and does not use these.

# --- Operational paths (must be writable by the splunk user) ----------------
LOG_DIR=/opt/kamusm/var/log
LOCK_DIR=/opt/kamusm/var/run
